# Prisma AIRS — AI Model Security (model-security CLI / model_security_client SDK)
# Copy to config/model-security.env (or .env / model-security.env) and fill in values.
# Do not put real secrets in this example file.
#
# Loaded automatically by airs-modelscan / install script when present.

MODEL_SECURITY_CLIENT_ID=
MODEL_SECURITY_CLIENT_SECRET=
TSG_ID=
MODEL_SECURITY_API_ENDPOINT=https://api.sase.paloaltonetworks.com/aims

# Optional
# MODEL_SECURITY_TOKEN_ENDPOINT=https://auth.apps.paloaltonetworks.com/oauth2/access_token
# MODEL_SECURITY_LOG_LEVEL=info

# pip install only — from SCM mgmt/v1/pypi/authenticate (or run scripts/fetch-pan-pypi-url.py)
MODEL_SECURITY_PYPI_URL=
